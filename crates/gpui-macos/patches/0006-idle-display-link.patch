+/// gpui wants a frame. An idle window restarts its display link and ticks now: a CVDisplayLink
+/// started within ~3 ms of a vsync first fires a refresh later.
+fn request_frame(window_state: &Arc<Mutex<MacWindowState>>) {
+    let mut lock = window_state.lock();
+    lock.frame_requested = true;
+    if lock.closed.load(Ordering::Acquire) || lock.display_link_running() {
+        return;
