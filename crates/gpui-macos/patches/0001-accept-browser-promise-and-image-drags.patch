 fn external_paths_from_event(dragging_info: *mut Object) -> Option<ExternalPaths> {
-    let mut paths = SmallVec::new();
     let pasteboard: id = unsafe { msg_send![dragging_info, draggingPasteboard] };
+
+    // Keep the legacy Finder representation first. It can contain several paths,
+    // unlike the scalar UTI representations used by browser drags.
     let filenames = unsafe { NSPasteboard::propertyListForType(pasteboard, NSFilenamesPboardType) };
-    if filenames == nil {
+    if filenames != nil {
+        let mut paths = SmallVec::new();
+        for file in unsafe { filenames.iter() } {
+            paths.push(PathBuf::from(unsafe { string_from_ns(file) }));
+        }
+        if !paths.is_empty() {
+            return Some(ExternalPaths(paths));
+        }
+    }
+
+    // Promise boards can also contain a not-yet-materialized file URL. Ask the
+    // drag source to fulfill it before accepting that URL as an ordinary file.
+    if let Some(paths) = promised_paths(dragging_info, pasteboard)
+        && !paths.is_empty()
+    {
+        return Some(ExternalPaths(paths));
+    }
+
+    if let Some(file_url) = pasteboard_string(pasteboard, "public.file-url") {
+        let url: id = unsafe { msg_send![class!(NSURL), URLWithString: ns_string(&file_url)] };
+        if url != nil {
+            let path: id = unsafe { msg_send![url, path] };
+            if path != nil {
+                let mut paths = SmallVec::new();
+                paths.push(PathBuf::from(unsafe { string_from_ns(path) }));
+                return Some(ExternalPaths(paths));
+            }
+        }
+    }
+
+    // Pass a web URL through ExternalPaths as an opaque value; the app recognises it.
+    if let Some(url) = pasteboard_string(pasteboard, "public.url")
+        && (url.starts_with("http://") || url.starts_with("https://"))
+    {
+        let mut paths = SmallVec::new();
+        paths.push(PathBuf::from(url));
+        return Some(ExternalPaths(paths));
+    }
+
+    for (pasteboard_type, extension) in [
+        (unsafe { NSPasteboardTypePNG }, "png"),
+        (unsafe { NSPasteboardTypeTIFF }, "tiff"),
+    ] {
+        let data: id = unsafe { msg_send![pasteboard, dataForType: pasteboard_type] };
+        if data == nil {
+            continue;
+        }
+        let length: usize = unsafe { msg_send![data, length] };
+        let bytes: *const u8 = unsafe { msg_send![data, bytes] };
+        if length == 0 || length > 512 * 1024 * 1024 || bytes.is_null() {
+            continue;
+        }
+        let directory = unique_drop_directory();
+        if std::fs::create_dir_all(&directory).is_err() {
+            return None;
+        }
+        let path = directory.join(format!("image.{extension}"));
+        let contents = unsafe { std::slice::from_raw_parts(bytes, length) };
+        if std::fs::write(&path, contents).is_ok() {
+            let mut paths = SmallVec::new();
+            paths.push(path);
+            return Some(ExternalPaths(paths));
+        }
+    }
+
+    None
+}
+
+unsafe fn string_from_ns(string: id) -> String {
+    unsafe {
+        CStr::from_ptr(NSString::UTF8String(string))
+            .to_string_lossy()
+            .into_owned()
+    }
+}
+
+fn pasteboard_string(pasteboard: id, pasteboard_type: &str) -> Option<String> {
+    let value: id = unsafe { msg_send![pasteboard, stringForType: ns_string(pasteboard_type)] };
+    (value != nil).then(|| unsafe { string_from_ns(value) })
+}
+
+fn pasteboard_has_type(pasteboard: id, pasteboard_type: &str) -> bool {
+    let types: id = unsafe { msg_send![pasteboard, types] };
+    types != nil && unsafe { msg_send![types, containsObject: ns_string(pasteboard_type)] }
+}
+
+fn promised_paths(dragging_info: id, pasteboard: id) -> Option<SmallVec<[PathBuf; 2]>> {
+    if !pasteboard_has_type(pasteboard, "com.apple.pasteboard.promised-file-url")
+        && !pasteboard_has_type(pasteboard, "com.apple.filepromise")
+        && !pasteboard_has_type(pasteboard, "NSFilesPromisePboardType")
+    {
         return None;
     }
-    for file in unsafe { filenames.iter() } {
-        let path = unsafe {
-            let f = NSString::UTF8String(file);
-            CStr::from_ptr(f).to_string_lossy().into_owned()
-        };
-        paths.push(PathBuf::from(path))
+
+    let directory = unique_drop_directory();
+    std::fs::create_dir_all(&directory).ok()?;
+    let destination: id = unsafe {
+        msg_send![class!(NSURL), fileURLWithPath: ns_string(&directory.to_string_lossy())]
+    };
+    let names: id =
+        unsafe { msg_send![dragging_info, namesOfPromisedFilesDroppedAtDestination: destination] };
+    if names == nil {
+        return None;
     }
-    Some(ExternalPaths(paths))
+    let mut paths = SmallVec::new();
+    for name in unsafe { names.iter() } {
+        paths.push(directory.join(unsafe { string_from_ns(name) }));
+    }
+    Some(paths)
+}
+
+fn unique_drop_directory() -> PathBuf {
+    let timestamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    std::env::temp_dir().join(format!(
+        "gpui-drop-{}-{timestamp}-{}",
+        std::process::id(),
+        DROP_SEQUENCE.fetch_add(1, Ordering::Relaxed)
+    ))
 }
 
