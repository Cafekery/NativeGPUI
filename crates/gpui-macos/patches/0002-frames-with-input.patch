             drop(lock);
             callback(event);
             window_state.lock().event_callback = Some(callback);
+            // Draw the frame this event dirtied now, inside the event, so the refresh it lands
+            // in follows the event's time and not whether it beat the display link's tick. A
+            // trackpad reports at 125 Hz against a 120 Hz display; a frame drawn only at the
+            // tick shows stall-and-double-step pairs whenever the two cross.
+            let mut lock = window_state.lock();
+            if lock.last_input_frame.elapsed() >= Duration::from_millis(3) {
+                lock.last_input_frame = Instant::now();
+                drop(lock);
+                frame(this as *const Object as *mut c_void);
