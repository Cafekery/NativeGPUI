 extern "C" fn step(view: *mut c_void) {
+    // A tick right after an input-driven frame has nothing new to show; the frame the input
+    // drew is what keeps the display at full rate. In a live resize every step draws through
+    // `displayLayer:` inside AppKit's own transaction, and a tick's present between two steps
+    // only costs a drawable.
+    let in_live_resize: BOOL = unsafe { msg_send![view as id, inLiveResize] };
+    if in_live_resize == YES {
+        return;
+    }
+    let window_state = unsafe { get_window_state(&*(view as id)) };
+    if window_state.lock().last_input_frame.elapsed() < Duration::from_millis(8) {
+        return;
+    }
+    frame(view);
+}
+
+/// One frame: gpui draws and presents, and the transaction carrying the drawable and every
+/// AppKit change made alongside it is committed now, not when the run loop next idles.
+fn frame(view: *mut c_void) {
     let view = view as id;
     let window_state = unsafe { get_window_state(&*view) };
     let mut lock = window_state.lock();
@@ -3373,6 +3407,9 @@ extern "C" fn step(view: *mut c_void) {
             ..Default::default()
         });
         window_state.lock().request_frame_callback = Some(callback);
+        unsafe {
+            let _: () = msg_send![class!(CATransaction), flush];
+        }
     }
 }
 
